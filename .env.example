# Copy to .env and fill in. Never commit .env.

# --- Required for live mode (npm start / npm run scan:once) ---
# Long-lived Threads user token with threads_basic + threads_keyword_search
THREADS_ACCESS_TOKEN=
# Token from @BotFather
TELEGRAM_BOT_TOKEN=
# Your numeric Telegram user ID (npm run telegram:whoami)
TELEGRAM_OWNER_USER_ID=
# Your private chat with the bot; for a private chat it equals your user ID
TELEGRAM_CHAT_ID=

# --- Optional (defaults shown) ---
# SCAN_INTERVAL_MINUTES=30
# LOOKBACK_HOURS=24
# MAX_REQUESTS_PER_SCAN=20
# RESULTS_PER_QUERY=50
# HTTP_TIMEOUT_MS=15000
# DATABASE_PATH=./data/leads.sqlite
# THREADS_API_BASE=https://graph.threads.com/v1.0
